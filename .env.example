# Personnalisation en marque blanche (toutes les variables sont optionnelles).
# Copiez ce fichier en .env.local et adaptez les valeurs à votre auto-école.

# Nom de la marque affiché dans l'application
NEXT_PUBLIC_BRAND_NAME="Permis Oral"

# Nom de votre auto-école (laisser vide pour une marque générique)
NEXT_PUBLIC_SCHOOL_NAME=""

# Slogan de la page d'accueil
NEXT_PUBLIC_BRAND_TAGLINE="Maîtrisez l'interrogation orale du permis B"

# E-mail de contact affiché dans le pied de page
NEXT_PUBLIC_CONTACT_EMAIL="contact@permis-oral.fr"

# Couleur primaire (hexadécimal #RRGGBB) — sert à générer la palette
NEXT_PUBLIC_PRIMARY_COLOR="#4f46e5"
