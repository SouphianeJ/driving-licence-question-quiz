# Configuration de la plateforme. Copiez ce fichier en .env.local.

# --- Base de données (MongoDB Atlas) — OBLIGATOIRE ---
# Chaîne de connexion fournie par Atlas (Database > Connect > Drivers).
MONGODB_URI="mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Nom de la base (optionnel, défaut : permis_oral).
MONGODB_DB="permis_oral"

# --- Authentification ---
# Secret de signature des sessions — OBLIGATOIRE en production.
# Générez une valeur aléatoire : `openssl rand -hex 32`
AUTH_SECRET=""

# Compte superadmin créé au premier démarrage (seed, si la base est vide).
SUPERADMIN_EMAIL="superadmin@permis-oral.fr"
SUPERADMIN_PASSWORD="superadmin"

# --- Divers ---
# E-mail de contact affiché sur la plateforme (optionnel).
NEXT_PUBLIC_CONTACT_EMAIL="contact@permis-oral.fr"
